# Server environment template for the always-on deployment: the database
# owner's file.
#
# Copy to the CLONE ROOT as `.env.db`, next to `.env`, and keep it mode 600:
#
#     (umask 077; cp deploy/example.env.db .env.db)
#
# Real values come from 1Password. Nothing in this file is a real secret and
# nothing real is ever committed — `.env.db` is git-ignored.
#
# Who reads it:
#   * the `db` service — deploy/docker-compose.yml's `env_file: ../.env.db`:
#     the postgres image's first-boot init and deploy/db-init/ read the
#     variables below. The scheduler container never gets this file.
#   * the Makefile — auto-exports it after .env, so `make migrate-up` on the
#     host picks up MIGRATION_DATABASE_URL from here.
#
# The scheduler's own variables (DATABASE_URL, the read URLs, the
# application's secrets) live in `.env`; see deploy/example.env. No name is
# set in both files.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE PASTING A PASSWORD CONTAINING `$`
# ---------------------------------------------------------------------------
# Docker Compose expands `$VAR` inside env_file values. A password of
# `ab$wcd` is delivered to the container as `ab` — compose substitutes the
# (undefined) variable `wcd` with an empty string and only logs
# `The "wcd" variable is not set` on stderr. Authentication then fails with a
# message that says nothing about the real cause.
#
# Escape every literal dollar sign by doubling it:  ab$wcd  ->  ab$$wcd
# This applies to every password below and the one inside
# MIGRATION_DATABASE_URL, as it does to the scheduler's `.env`.
# `make` (which also reads this file) has the same hazard with `$`.
#
# The simpler option: generate the Postgres passwords from an alphanumeric
# alphabet so the question never comes up — e.g. `openssl rand -hex 24`.
# Verify after editing: the command below must print no "variable is not set"
# warnings.
#
#     docker compose -f deploy/docker-compose.yml config --quiet

# ---------------------------------------------------------------------------
# PostgreSQL — the `db` service
# ---------------------------------------------------------------------------

# Superuser created by the postgres image on first boot. Used inside the db
# container (psql, the cutover pg_restore); migrations run as the owner and
# the application never connects as this role.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-superuser-password  # pragma: allowlist secret
POSTGRES_DB=receipt_index

# Passwords for the three logins deploy/db-init/01-create-roles.sh creates on
# first boot, one per level of the Database Standards:
#   receipt_index        _all    owns every object; migrations only
#   receipt_index_write  _write  the application (member of receipt_index_dev_write)
#   receipt_index_read   _read   backups, forensics, the MCP server
#                                (member of receipt_index_dev_read)
# Each must match the password in its URL: MIGRATION_DATABASE_URL below for
# the owner, the URLs in .env for the other two. Changing one later requires
# an ALTER ROLE (or \password in psql): the init script only runs once,
# against an empty data directory. Keep all three here even after first boot:
# a disaster-recovery rebuild runs the init script again from this file.
RECEIPT_INDEX_PASSWORD=replace-with-owner-password  # pragma: allowlist secret
RECEIPT_INDEX_WRITE_PASSWORD=replace-with-write-password  # pragma: allowlist secret
RECEIPT_INDEX_READ_PASSWORD=replace-with-read-password  # pragma: allowlist secret

# ---------------------------------------------------------------------------
# Migrations — the owner login, from the host
# ---------------------------------------------------------------------------

# Migrations, run from the HOST with `make migrate-up`. Points at the
# loopback-published port, so it uses 127.0.0.1 and the host port below.
#
# Runs as `receipt_index` (the database/schema owner), NOT the superuser, so
# every object created by a migration is owned by the owner role — the same
# ownership model the cutover restore produces. pg_trgm is a trusted extension
# (PG 13+), so the owner can CREATE EXTENSION without superuser.
#
# MUST already contain a `?` query parameter: the Makefile appends
# `&x-migrations-table=...` to this string, and without an existing `?` the
# resulting URL is malformed and golang-migrate fails to connect.
MIGRATION_DATABASE_URL=postgresql://receipt_index:replace-with-owner-password@127.0.0.1:15432/receipt_index?sslmode=disable  # pragma: allowlist secret
