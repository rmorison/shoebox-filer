# Secrets — referenced by receipt-index.yaml via ${VAR_NAME} interpolation
IMAP_PASSWORD=app-specific-password
ANTHROPIC_API_KEY=sk-ant-...

# Google Drive (optional, after running: receipt-index auth gdrive --client-credentials ...)
# GDRIVE_TOKEN_JSON='{"token":"...","refresh_token":"...","client_id":"...","client_secret":"..."}'

# Database — used by receipt-index.yaml and make migrate-up
DATABASE_URL=postgresql://receipt_index_dev_write:localpass@localhost:15432/receipt_index_dev
MIGRATION_DATABASE_URL=postgresql://main:localpass@localhost:15432/receipt_index_dev?sslmode=disable

# Docker Compose and integration tests — host ports.
# Left unset on purpose. Docker Compose falls back to its own defaults
# (15432, 3025, 3143), but the integration tests have no fallback: until all
# three are set, every integration test skips without connecting. Choose
# ports nothing else on this host uses (on a host shared with another stack,
# don't use the defaults), uncomment the lines, and match the Postgres port in
# the two URLs above. See "Integration tests" in docs/user/getting-started.md.
# POSTGRES_HOST_PORT=25432
# GREENMAIL_SMTP_PORT=23025
# GREENMAIL_IMAP_PORT=23143

# Playwright — local browser install path (set by `make setup`)
PLAYWRIGHT_BROWSERS_PATH=.playwright
